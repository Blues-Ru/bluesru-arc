<!DOCTYPE html>
<html lang="ru">
<head>
  <title>Blues.Ru: обзор дисков{% if current_month %} — {{ current_month }}{% elif current_year %} — {{ current_year }}{% endif %}</title>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <link rel="shortcut icon" href="/images/bluesru.ico">
  {% if canonical_url %}<link rel="canonical" href="{{ canonical_url }}">{% endif %}
  <style>
    body { max-width: 900px; margin: 0 auto; padding: 0 1em; }
    .review-entry { display: flex; align-items: flex-start; margin-bottom: 0.7em; }
    .review-cover { flex-shrink: 0; margin-right: 0.7em; }
    .review-cover img { width: 50px; height: 50px; object-fit: cover; }
    .review-info { flex: 1; }
    .year-months { margin: 0.2em 0 0.5em 0; font-size: 0.95em; line-height: 1.8; }
    .year-nav-compact { font-size: 0.9em; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .year-nav-compact .yn-cur { font-weight: bold; font-size: 1.1em; }
    .year-nav-all { font-size: 0.85em; line-height: 2; }
  </style>
{{ site_css_tag | safe }}
  {{ ga_snippet | safe }}
</head>
<body bgcolor="#ffffff" text="#000000" link="#0000ff" vlink="#5511cc" alink="#00bb00">

<a href="/"><img src="/images/bluesru-logo.svg" width="120" height="120" border="0" alt="Blues.Ru" style="float:right"></a>

<h2><a href="/review/">CD обзор</a>{% if current_month %} — {{ current_month }}{% elif current_year %} — {{ current_year }}{% endif %}</h2>
<p style="font-size:0.9em"><a href="/author/">Авторы</a></p>

{% if nav_links %}<p>{{ nav_links | safe }}</p>{% endif %}

{% if year_nav %}
{%- set ns = namespace(prev=None, cur=None, next=None) %}
{%- for yn in year_nav %}
  {%- if yn.current %}
    {%- set ns.cur = yn %}
    {%- if not loop.first %}{% set ns.prev = year_nav[loop.index0 - 1] %}{% endif %}
    {%- if not loop.last %}{% set ns.next = year_nav[loop.index0 + 1] %}{% endif %}
  {%- endif %}
{%- endfor %}
<div class="year-nav-compact">
  {% if ns.prev %}<a href="/review/{{ ns.prev.year }}/">&laquo; {{ ns.prev.year }}</a>{% else %}<span style="color:#ccc">&laquo;</span>{% endif %}
  <span class="yn-cur">{{ ns.cur.year if ns.cur else current_year }}</span>
  {% if ns.next %}<a href="/review/{{ ns.next.year }}/">{{ ns.next.year }} &raquo;</a>{% else %}<span style="color:#ccc">&raquo;</span>{% endif %}
</div>
{% if current_year_months %}
<div class="year-months">
{% for m in current_year_months %}{% if not loop.first %} | {% endif %}<a href="#{{ m.key }}">{{ m.label }}</a>{% endfor %}
</div>
{% endif %}
<hr size="1">
{% endif %}

{% for month_block in month_blocks %}
<h3 id="{{ month_block.key }}">{{ month_block.label }}</h3>
<ul>
{% for r in month_block.reviews %}
  <li class="review-entry">
    {% if r.cover_url %}<span class="review-cover"><a href="{{ r.url }}"><img src="{{ r.cover_url }}" alt="обложка" border="0"></a></span>{% endif %}
    <span class="review-info"><a href="{{ r.url }}">{% if r.artist_name %}<b>{{ r.artist_name | e }}</b> — {% endif %}<b>{{ r.album_title | e }}</b></a>{% if r.year %}, {{ r.year }}{% endif %}<span class="review-meta">{% if r.mark %}{{ star_rating_html(r.mark) }}{% endif %}<i>{{ r.author | e }}</i></span></span>
  </li>
{% endfor %}
</ul>
{% if not loop.last %}<hr size="1">{% endif %}
{% endfor %}

{% if more_html %}
<p>{{ more_html | safe }}</p>
{% endif %}

{% if month_list and not year_nav %}
<hr size="1">
<p>
{% for m in month_list %}{% if not loop.first %} | {% endif %}<a href="/review/{{ m.key }}/">{{ m.label }}</a>{% endfor %}
</p>
{% endif %}

{% if year_nav %}
<hr size="1">
<p><b>Все годы:</b><br>
<span class="year-nav-all">
{% for yn in year_nav %}{% if not loop.first %} | {% endif %}{% if yn.current %}<b>{{ yn.year }}</b>{% else %}<a href="/review/{{ yn.year }}/">{{ yn.year }}</a>{% endif %}{% endfor %}
</span></p>
{% endif %}

<hr size="1" />

<p align="center">
{{ footer }}
</p>
</body>
</html>
