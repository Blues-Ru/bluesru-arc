<!DOCTYPE html>
<html lang="ru">
<head>
<title>{{ author_name }} — Форум Blues.Ru</title>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="shortcut icon" href="/images/bluesru.ico">
<link rel="stylesheet" href="/css/site.css">
<link rel="stylesheet" href="/css/responsive.css">
<link rel="stylesheet" href="/forum/liveforum.css">
<link rel="stylesheet" href="/css/forum-authors.css">
{{ ga_snippet | safe }}
</head>
<body bgcolor="#ffffff" text="#000000" link="#0000ff" vlink="#5511cc" alink="#00bb00">

<a href="/"><img src="/images/bluesru-logo.svg" width="120" height="120" border="0" alt="Blues.Ru" style="float:right"></a>

<h3><a href="/">Blues.Ru</a> &rsaquo; <a href="/forum/">Форум</a> &rsaquo; <a href="/forum/authors/">Авторы</a> &rsaquo; {{ author_name }}</h3>

{% if top_topics %}
<table class="at">
<tr>
  <th class="r" style="width:3em">Год</th>
  <th>Тема</th>
  <th class="r">Ответы</th>
  <th class="r">Участники</th>
</tr>
{% for t in top_topics %}
<tr{% if loop.index > 20 %} class="topic-extra" style="display:none"{% endif %}>
  <td class="nr sm">{{ t.year }}</td>
  <td><a href="/forum/{{ t.slug }}">{{ t.title }}</a></td>
  <td class="nr sm">{{ t.post_count }}</td>
  <td class="nr sm">{{ t.participant_count }}</td>
</tr>
{% endfor %}
</table>
<div id="topics-more" onclick="showMoreTopics()"></div>
{% endif %}

{% for year_data in activity %}
<div class="activity-year">
  <b>{{ year_data.year if year_data.year else '?' }}</b>
  <span class="sm">({{ year_data.topics_count }})</span>
  {% for m in year_data.months %}
  <div class="month-block">
    <span class="month-label">{{ m.month_name }}</span>
    {% for tr in m.topic_refs %}
    <span class="post-link"><a href="/forum/{{ tr.topic_slug }}{% if tr.post_id %}#post{{ tr.post_id }}{% endif %}">{{ tr.topic_title }}</a> <span class="sm">({{ tr.post_count }}&nbsp;/&nbsp;{{ tr.participant_count }})</span></span>
    {% endfor %}
  </div>
  {% endfor %}
</div>
{% endfor %}

<p class="sm"><a href="{{ author_search_url }}">Все сообщения автора в форуме</a></p>

<script>
var _topicsPage = 0;
var TOPICS_STEP = 20;
var _extraRows = null;

function initTopicsMore() {
  _extraRows = Array.from(document.querySelectorAll('.topic-extra'));
  if (_extraRows.length > 0) updateTopicsMore();
}

function showMoreTopics() {
  var start = _topicsPage * TOPICS_STEP;
  var end = Math.min(start + TOPICS_STEP, _extraRows.length);
  for (var i = start; i < end; i++) _extraRows[i].style.display = '';
  _topicsPage++;
  updateTopicsMore();
}

function updateTopicsMore() {
  var remaining = _extraRows.length - _topicsPage * TOPICS_STEP;
  var btn = document.getElementById('topics-more');
  if (remaining <= 0) {
    btn.style.display = 'none';
  } else {
    btn.style.display = 'inline-block';
    btn.textContent = 'Ещё (' + Math.min(remaining, TOPICS_STEP) + ')…';
  }
}

initTopicsMore();
</script>

<hr size="1">
<p align="center">
{{ footer | safe }}
</p>
</body>
</html>
