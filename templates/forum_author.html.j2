<!DOCTYPE html>
<html lang="ru">
<head>
<title>{{ author_name }} — Форум Blues.Ru</title>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="shortcut icon" href="/images/bluesru.ico">
<link rel="stylesheet" href="/css/site.css">
<link rel="stylesheet" href="/css/responsive.css">
<link rel="stylesheet" href="/forum/liveforum.css">
<style>
body { max-width: 900px; margin: 0 auto; padding: 0 1em; }
.author-stats { color: #555; font-size: 0.9em; margin-bottom: 1em; }
.top-topics { margin-bottom: 2em; }
.top-topics table { border-collapse: collapse; width: 100%; }
.top-topics td, .top-topics th { padding: 3px 6px; vertical-align: top; }
.top-topics th { text-align: left; font-weight: bold; border-bottom: 1px solid #ccc; }
.topic-title { font-weight: bold; }
.topic-meta { color: #777; font-size: 0.85em; }
.activity-year { margin-bottom: 1.5em; }
.month-block { margin-left: 1em; margin-bottom: 0.4em; }
.month-label { font-weight: bold; color: #444; min-width: 3em; display: inline-block; }
.post-link { font-size: 0.85em; }
.post-link + .post-link::before { content: ' · '; color: #aaa; }
</style>
{{ ga_snippet | safe }}
</head>
<body bgcolor="#ffffff" text="#000000" link="#0000ff" vlink="#5511cc" alink="#00bb00">

<a href="/"><img src="/images/bluesru-logo.svg" width="120" height="120" border="0" alt="Blues.Ru" style="float:right"></a>

<h3><a href="/">Blues.Ru</a> &rsaquo; <a href="/forum/">Форум</a> &rsaquo; <a href="/forum/authors/">Авторы</a> &rsaquo; {{ author_name }}</h3>

<div class="author-stats">
  Темы: <b>{{ topics_count }}</b> &nbsp;|&nbsp;
  Ответы: <b>{{ replies_count }}</b> &nbsp;|&nbsp;
  Авторы: <b>{{ participants_count }}</b>
</div>

{% if top_topics %}
<div class="top-topics">
<h4>Самые активные темы</h4>
<table>
<tr>
  <th>Тема</th>
  <th>Дата</th>
  <th style="text-align:right">Авторы</th>
  <th style="text-align:right">Ответы</th>
</tr>
{% for t in top_topics %}
<tr>
  <td class="topic-title"><a href="/forum/{{ t.slug }}">{{ t.title }}</a></td>
  <td class="topic-meta">{{ t.first_post_fmt }}</td>
  <td class="topic-meta" style="text-align:right">{{ t.participant_count }}</td>
  <td class="topic-meta" style="text-align:right">{{ t.post_count }}</td>
</tr>
{% endfor %}
</table>
<p class="topic-meta"><small>Авторы — уникальных участников &nbsp; Ответы — всего сообщений</small></p>
</div>
{% endif %}

<hr size="1">

<h4>Темы по годам</h4>

{% for year_data in activity %}
<div class="activity-year">
  <b>{{ year_data.year if year_data.year else '?' }}</b>
  <span class="topic-meta">({{ year_data.topics_count }} тем)</span>
  {% for m in year_data.months %}
  <div class="month-block">
    <span class="month-label">{{ m.month_name }}</span>
    {% for tr in m.topic_refs %}
    <span class="post-link"><a href="/forum/{{ tr.topic_slug }}{% if tr.post_id %}#post{{ tr.post_id }}{% endif %}">{{ tr.topic_title }}</a></span>
    {% endfor %}
  </div>
  {% endfor %}
</div>
{% endfor %}

<hr size="1">
<p align="center">
{{ footer | safe }}
</p>
</body>
</html>
