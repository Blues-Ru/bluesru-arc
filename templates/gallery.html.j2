<!DOCTYPE html>
<html lang="ru">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<title>{{ title or path }} — Blues.Ru</title>
<link rel="shortcut icon" href="/images/bluesru.ico">
<link rel="stylesheet" href="/static/css/gallery.css">
{{ site_css_tag | safe }}
{{ ga_snippet | safe }}
</head>
<body>
<div class="gallery-page">

<div class="gallery-header">
  <div class="gallery-breadcrumb">
    <a href="/">Blues.Ru</a><span>→</span><a href="/photo/">Фото</a>
    {%- if year %}<span>→</span><a href="/photo/#y{{ year }}">{{ year }}</a>{% endif %}
    <span>→</span>{{ title or path }}
  </div>
  <h1>{{ title or path }}</h1>
  {% if date or photo_count %}<div class="gallery-meta">
    {%- if date %}{{ date }}{% endif %}
    {%- if date and photo_count %} &nbsp;·&nbsp; {% endif %}
    {%- if photo_count %}{{ photo_count }} фото{% endif %}
  </div>{% endif %}
  {% if description %}<div class="gallery-desc">{{ description }}</div>
  {% elif extra_text %}<div class="gallery-desc">{{ extra_text }}</div>{% endif %}
  {% if source_articles %}
  <div class="gallery-articles">Статьи:
    {% for art in source_articles %}{% if art %}<a href="{{ art.url }}">{{ art.title }}</a>{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}
  </div>{% endif %}
</div>

<div class="gallery-grid" id="grid">
{%- for photo in photos %}
<div class="gallery-thumb">
  <a href="{{ photo.file }}" data-idx="{{ loop.index0 }}"{% if photo.caption %} title="{{ photo.caption }}"{% endif %}>
    <img src="{{ photo.thumb }}" loading="lazy" alt="{{ photo.caption or '' }}">
  </a>
  {%- if photo.caption and photo.caption != (title or path) %}
  <div class="thumb-caption">{{ photo.caption }}</div>
  {%- else %}
  <div class="thumb-caption"></div>
  {%- endif %}
</div>
{%- endfor %}
</div>
<div class="gallery-count">{{ photo_count }} фотографий</div>

</div><!-- .gallery-page -->

{% include "footer_snippet.html.j2" ignore missing %}

<!-- Lightbox -->
<div id="lb">
  <span id="lb-close">✕</span>
  <span id="lb-counter"></span>
  <img id="lb-img" src="" alt="">
  <span id="lb-prev">‹</span>
  <span id="lb-next">›</span>
  <div id="lb-caption"></div>
</div>
<script src="/static/js/gallery.js"></script>
<script>initGallery({{ photos_json | safe }});</script>
</body>
</html>
