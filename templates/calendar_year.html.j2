<!DOCTYPE html>
<html>
<head>
<title>Календарь - {{ year }} год — Blues.Ru</title>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="shortcut icon" href="/images/bluesru.ico">
<link rel="stylesheet" href="/css/site.css">
<link rel="stylesheet" href="/css/responsive.css">
<style>
body { max-width: 900px; margin: 0 auto; padding: 0 1em; }
.cal-table { border-collapse: collapse; width: 100%; }
.cal-table td { padding: 4px 6px; vertical-align: top; border-bottom: 1px solid #eee; }
.cal-meta { white-space: nowrap; color: #555; font-size: 0.88em; width: 1%; }
.cal-title { font-weight: bold; }
.cal-ago { color: #888; font-size: 0.85em; }
.cal-etype { color: #555; font-size: 0.85em; }
.records-grid { display: flex; flex-wrap: wrap; gap: 10px 16px; margin: 0.5em 0; }
.record-card { display: flex; gap: 8px; align-items: flex-start; width: calc(50% - 8px); min-width: 240px; }
.record-card img { flex-shrink: 0; width: 64px; height: 64px; object-fit: cover; display: block; border: 1px solid #ddd; }
.record-info { flex: 1; font-size: 0.9em; line-height: 1.4; }
@media (max-width: 600px) { .record-card { width: 100%; } }
</style>
{{ ga_snippet | safe }}
</head>
<body bgcolor="#ffffff" text="#000000" link="#0000ff" vlink="#5511cc" alink="#00bb00">

<a href="/"><img src="/images/bluesru-logo.svg" width="120" height="120" border="0" alt="Blues.Ru" style="float:right"></a>

<h3><a href="/">Blues.Ru</a> &gt; <a href="/calendar/">Календарь</a> &gt; {{ year }} год{{ years_ago_str }}{% if records %} | <a href="#records">Записи</a>{% endif %}</h3>
<p>{{ year_nav | safe }}</p>

<table class="cal-table">
{% for ev in events %}
<tr>
  <td class="cal-meta">
    {{ ev.day_month }}
  </td>
  <td>
    {%- if ev.picture %}<img src="/calendar/images/{{ ev.picture }}" border="0" align="right" vspace="4" hspace="8" style="max-width:160px;max-height:110px;">{% endif %}
    {{ ev.text | safe }}
    {%- if ev.picture %}<br clear="both">{% endif %}
  </td>
</tr>
{% endfor %}
</table>

<p align="right"><i>Проект Андрея Евдокимова</i></p>

{% if records %}
<hr size="1">
<h2><a name="records" id="records">Записи {{ year }}</a></h2>
<div class="records-grid">
{% for rec in records %}
<div class="record-card">
  <a href="/artist/{{ rec.artist_slug }}/{{ rec.album_url_slug }}/">
    <img src="{{ rec.cover_url }}" alt="{{ rec.title | e }}" border="0">
  </a>
  <div class="record-info">
    <a href="{{ rec.artist_url }}">{{ rec.artist | e }}</a><br>
    <a href="/artist/{{ rec.artist_slug }}/{{ rec.album_url_slug }}/">{{ rec.title | e }}</a>
  </div>
</div>
{% endfor %}
</div>
{% endif %}

<hr size="1">

<p>{{ year_nav | safe }}</p>

<p align="center">
{{ footer | safe }}
</p>
</body>
</html>
