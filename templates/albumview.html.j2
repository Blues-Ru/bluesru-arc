<!DOCTYPE html>
<HTML lang="ru">
  <HEAD>
    <title>Blues.Ru - {{ artist_name }}{% if album.title %} - {{ album.title }}{% if album.year %}, {{ album.year }}{% endif %}{% endif %}</title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <link rel="shortcut icon" href="/images/bluesru.ico">
    <style>body { max-width: 900px; margin: 0 auto; padding: 0 1em; }</style>
  {{ site_css_tag | safe }}
  {{ ga_snippet | safe }}
</head>
  <body bgcolor="#ffffff" text="#000000" link="#0000ff" vlink="#5511cc" alink="#00bb00">

    <a href="/"><img src="/images/bluesru-logo.svg" width="120" height="120" border="0" alt="Blues.Ru" style="float:right"></a>

{% if album.title %}
<h3><a href="/">Blues.Ru</a> &gt; <a href="/artist/">Музыканты</a> &gt;
<a href="/artist/{{ artist_legacy_path }}/">{{ artist_name }}</a> &gt;
<a href="/artist/{{ artist_legacy_path }}/#review">Обзоры</a> &gt;
{% if album.year %}{{ album.year }} &mdash; {% endif %}{{ album.title }}</h3>
{% else %}
<h2><a href="/artist/">Музыканты</a> : &#32;
{% if artist_legacy_path %}
<a href="/artist/{{ artist_legacy_path }}/">{{ artist_name }}</a>
{% elif artist_name %}
{{ artist_name }}
{% else %}
<a href="/review/">Разные артисты</a>
{% endif %}
</h2>
{% endif %}

{% if cover_url or album.title %}
<div class="album-header">
{% if cover_url %}
  <div class="album-header-cover"><img src="{{ cover_url }}" width="160" height="160" border="0" alt="" style="display:block;object-fit:cover"></div>
{% endif %}
  <div class="album-header-info">
    <table cellpadding="3" border="0" cellspacing="0" style="font-size:0.95em">
{% if album.artist %}
      <tr><td style="color:#888;padding-right:12px">Артист:</td><td>{{ album.artist }}</td></tr>
{% endif %}
{% if album.title %}
      <tr><td style="color:#888;padding-right:12px">Название:</td><td>{{ album.title }}</td></tr>
{% endif %}
{% if album.year %}
      <tr><td style="color:#888;padding-right:12px">Год:</td><td><a href="/calendar/{{ album.year }}/#records">{{ album.year }}</a></td></tr>
{% endif %}
{% if album.label %}
      <tr><td style="color:#888;padding-right:12px">Лейбл:</td><td>{{ album.label }}</td></tr>
{% endif %}
{% if album.asin or streaming_links or artist_streaming_links %}
      <tr><td style="color:#888;padding-right:12px;padding-top:6px">Альбом на:</td>
      <td style="padding-top:6px">
        {% if album.asin %}<a target="_blank" href="https://www.amazon.com/dp/{{ album.asin }}">Amazon</a>{% endif %}
        {% if (streaming_links or artist_streaming_links) and album.asin %}&nbsp;{% endif %}
        {% if streaming_links %}{{ streaming_links | safe }}{% elif artist_streaming_links %}{{ artist_streaming_links | safe }}{% endif %}
      </td></tr>
{% endif %}
    </table>
  </div>
</div>
{% endif %}

{% if stream_icons is defined and stream_icons %}
{{ stream_icons | safe }}
{% endif %}
{% if artist_resource_links is defined and artist_resource_links %}
<p>{{ artist_resource_links | safe }}</p>
{% endif %}
{% if artist_photo_html is defined and artist_photo_html %}
{{ artist_photo_html | safe }}
{% endif %}
{% if artist_atb_links is defined and artist_atb_links %}
<p>{{ artist_atb_links | safe }}</p>
{% endif %}
{% if artist_calendar_links is defined and artist_calendar_links %}
<p>{{ artist_calendar_links | safe }}</p>
{% endif %}

{% if artist_album_list is defined and artist_album_list %}
{{ artist_album_list | safe }}
{% endif %}
{% if reviews %}
<hr size="1">
<h2>Обзоры</h2>
{% for review in reviews %}
<h3><a name="{{ review.id }}"></a>{% if review.mark %}{{ star_rating_html(review.mark) }}{% endif %}{{ review.author }}</h3>
{{ review.body | safe }}
<hr size="1">
{% endfor %}
{% endif %}

    <p align="center">
{{ footer }}
    </p>
  </body>
</HTML>
