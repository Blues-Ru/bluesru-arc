<!DOCTYPE html>
<html lang="ru">
<head>
  <title>Blues.Ru: CD обзор — {{ author | e }}</title>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="shortcut icon" href="/images/bluesru.ico">
  <link rel="stylesheet" href="/css/site.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <style>
    body { max-width: 900px; margin: 0 auto; padding: 0 1em; }
    .review-entry { display: flex; align-items: flex-start; margin-bottom: 0.5em; }
    .review-cover { flex-shrink: 0; margin-right: 0.7em; }
    .review-cover img { width: 50px; height: 50px; object-fit: cover; }
    .review-info { flex: 1; }
    .artist-section { margin-top: 1.2em; }
    a { text-decoration: none; }
    a:hover { text-decoration: underline; }
  </style>
  {{ ga_snippet | safe }}
</head>
<body bgcolor="#ffffff" text="#000000" link="#0000ff" vlink="#5511cc" alink="#00bb00">

<a href="/"><img src="/images/bluesru-logo.svg" width="120" height="120" border="0" alt="Blues.Ru" style="float:right"></a>

<h2><a href="/">Blues.Ru</a> &gt; <a href="/review/">Обзоры</a> &gt; <a href="/author/">Авторы</a> &gt; {{ author | e }}</h2>
<hr size="1">

{% for group in artist_groups %}
<div class="artist-section">
<h3>{% if group.artist_slug %}<a href="/artist/{{ group.artist_slug }}/">{{ group.artist_name | e }}</a>{% else %}{{ group.artist_name | e }}{% endif %}</h3>
{% for r in group.albums %}
<div class="review-entry">
  {% if r.cover_url %}<span class="review-cover"><a href="{{ r.url }}"><img src="{{ r.cover_url }}" alt="" border="0"></a></span>{% endif %}
  <span class="review-info"><a href="{{ r.url }}#review"><b>{{ r.album_title | e }}</b></a>{% if r.year %}, {{ r.year }}{% endif %}{% if r.mark %} {{ star_rating_html(r.mark) }}{% endif %}</span>
</div>
{% endfor %}
</div>
{% endfor %}

<hr size="1" />
<p align="center">{{ footer }}</p>
</body>
</html>
