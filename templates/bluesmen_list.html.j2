<!DOCTYPE html>
<html lang="ru">
<head>
  <title>Блюзовые музыканты — Blues.Ru</title>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <link rel="shortcut icon" href="/images/bluesru.ico">
  <link rel="stylesheet" href="/css/bluesmen.css">
{{ site_css_tag | safe }}
  {{ ga_snippet | safe }}
</head>
<body bgcolor="#FFFFFF" text="#000000" link="#0000FF" vlink="#5511CC" alink="#00BB00">

<a href="/"><img src="/images/bluesru-logo.svg" width="120" height="120" border="0" alt="Blues.Ru" style="float:right"></a>
<img src="/images/bluesman.gif" align="left" hspace="0" WIDTH="385" HEIGHT="98" style="clip-path:inset(0 10px 0 0)">
<br style="clear:both">

<p><big><b>
{% for letter in letters %}
{% if letter_has_artists[letter] %}<a href="#{{ letter }}">{{ letter }}</a>{% else %}{{ letter }}{% endif %}&#32;
{% endfor %}
</b></big>
<input type="text" id="artist-filter" placeholder="Поиск музыканта..." oninput="filterArtists(this.value)" autofocus>
</p>

{% for letter in letters %}
{% if letter_has_artists[letter] %}
<div class="letter-section visible" id="section-{{ letter }}">
<p><a name="{{ letter }}"><big><b>{{ letter }}</b></big></a></p>
{% for artist in artists_by_letter[letter] %}
{% if artist.secondary %}
<div class="artist-entry visible artist-xref" data-name="{{ artist.name | lower | e }} {{ artist.sort_name | lower | e }}">{{ artist.sort_name | e }} → <a href="#{{ artist.slug }}">{{ artist.name | e }}</a></div>
{% elif artist.legacy_dir and not artist.external %}
<div class="artist-entry visible" data-name="{{ artist.name | lower | e }} {{ artist.sort_name | lower | e }}"><a name="{{ artist.slug }}"></a><a href="/artist/{{ artist.legacy_dir }}/">{{ artist.name | e }}</a>{% if artist.resource_links %} — <small class="artist-res">{{ artist.resource_links | safe }}</small>{% endif %}</div>
{% else %}
<div class="artist-entry visible" data-name="{{ artist.name | lower | e }} {{ artist.sort_name | lower | e }}">{{ artist.name | e }}</div>
{% endif %}
{% endfor %}
</div>
{% endif %}
{% endfor %}

<script src="/js/bluesmen.js"></script>
<hr size="1" />
<p align="center">{{ footer }}</p>
</body>
</html>
