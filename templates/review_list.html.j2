<!DOCTYPE html>
<HTML lang="ru">
  <HEAD>
    <title>Blues.ru - обзоры блюзовых дисков</title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <link rel="shortcut icon" href="/images/bluesru.ico">
  <style>body { max-width: 900px; margin: 0 auto; padding: 0 1em; }</style>
  {{ site_css_tag | safe }}
  {{ ga_snippet | safe }}
</head>
  <body bgcolor="#ffffff" text="#000000" link="#0000ff" vlink="#5511cc" alink="#00bb00">

<a href="/"><img src="/images/bluesru-logo.svg" width="120" height="120" border="0" alt="Blues.Ru" style="float:right"></a>


    <h1>CD обзор</h1>

    <form action="/review/" method="get">
  <p><select name="p"><option value="0">Все периоды ({{ total_count }})</option>
{% for period in periods %}
      <option value="{{ period.value }}">{{ period.label }}
      ({{ period.count }})
    </option>
{% endfor %}
</select>

<select name="aid">
  <option value="0">Все авторы ({{ total_count }})</option>
{% for author in authors %}
  <option value="{{ author.id }}">{{ author.name | e }}
    ({{ author.count }})
  </option>
{% endfor %}
</select>

</p>
</form>

<ul>
{% for review in reviews %}
  <li>
    <a href="/review/{{ review.slug }}/">{% if review.artist_name %}{{ review.artist_name | e }}&#160;{% endif %}<b>&quot;{{ review.album_title | e }}&quot;</b></a>{% if review.year %}, {{ review.year }}{% endif %}
    - <i>{{ review.author | e }}</i>
  </li>
{% endfor %}
</ul>

<hr size="1" />
<p align="center">
{{ footer }}
</p>
  </body>
</HTML>
