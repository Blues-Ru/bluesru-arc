<!DOCTYPE html>
<html lang="ru">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<title>Фото — Blues.Ru</title>
<link rel="shortcut icon" href="/images/bluesru.ico">
<link rel="canonical" href="https://blues.ru/photo/">
<link rel="stylesheet" href="/css/photo.css">
{{ site_css_tag | safe }}
{{ ga_snippet | safe }}
</head>
<body>
<div class="photo-index">

<table cellpadding="4" cellspacing="0" border="0" align="right">
<tr><td align="left">
  <a href="/"><img src="/images/bluesru-logo.svg" width="120" height="120" border="0" alt="Blues.Ru"></a>
</td></tr>
</table>

<h1><a href="/">Blues.Ru</a> → Фото</h1>

<p>Фотографии с концертов и фестивалей. Автор большей части - Андрей Евдокимов.</p>

<div class="year-nav">
{% for year in years %}<a href="#y{{ year }}">{{ year }}</a>{% endfor %}
{% if misc_galleries %}<a href="#misc">Разное</a>{% endif %}
</div>

{% for year, galleries in by_year %}
<div class="year-section" id="y{{ year }}">
<h2>{{ year }}</h2>
<div class="gallery-grid">
{% for g in galleries %}
<div class="gallery-card">
  <a href="{{ g.canonical_url }}">
    {% if g.thumb %}
    <img src="{{ g.thumb }}" loading="lazy" alt="{{ g.title }}">
    {% else %}
    <div class="no-thumb">нет фото</div>
    {% endif %}
    <div class="card-title">{{ g.title }}</div>
    <div class="card-meta">
      {%- if g.photo_count %}{{ g.photo_count }} фото{% endif %}
      {%- if g.date %} <span class="card-date">· {{ g.date }}</span>{% endif %}
    </div>
  </a>
</div>
{% endfor %}
</div>
</div>
{% endfor %}

{% if misc_galleries %}
<div class="year-section" id="misc">
<h2>Разное</h2>
<div class="gallery-grid">
{% for g in misc_galleries %}
<div class="gallery-card">
  <a href="{{ g.canonical_url }}">
    {% if g.thumb %}
    <img src="{{ g.thumb }}" loading="lazy" alt="{{ g.title }}">
    {% else %}
    <div class="no-thumb">нет фото</div>
    {% endif %}
    <div class="card-title">{{ g.title }}</div>
    {% if g.photo_count %}<div class="card-meta">{{ g.photo_count }} фото</div>{% endif %}
  </a>
</div>
{% endfor %}
</div>
</div>
{% endif %}

</div><!-- .photo-index -->
{% include "footer_snippet.html.j2" ignore missing %}

<hr size="1" />

<p align="center">
{{ footer }}
</p>

</body>
</html>
